# Fonte de verdade real é o Infisical — este arquivo só documenta quais
# variáveis existem. Ver design em docs-warehouse/architecture.

APP_ENVIRONMENT=development
DOCS_ENABLED=true

# /database (Postgres do api-core, acessado somente para leitura, mesma instância/credenciais)
# Em produção DB_POSTGRES_SSLMODE deve ser require, verify-ca ou verify-full.
DB_POSTGRES_HOST=localhost
DB_POSTGRES_PORT=5432
DB_POSTGRES_CORE=coredb
DB_POSTGRES_USER=solier_readonly
DB_POSTGRES_PASSWORD=replace-with-a-secret
DB_POSTGRES_SSLMODE=disable

# /feeddb (Neo4j feeddb, opcional: sem estas variáveis os feeds usam só o fallback SQL, como no QA)
# DB_NEO4J_URI=bolt://localhost:7687
# DB_NEO4J_USER=neo4j
# DB_NEO4J_PASSWORD=replace-with-a-secret
# DB_NEO4J_FEED=feeddb
# Tempo máximo para falar com o Neo4j e pausa antes de tentar de novo depois de uma falha.
GRAPH_TIMEOUT_SECONDS=3
GRAPH_RETRY_AFTER_SECONDS=30

# Origens aceitas no CORS, separadas por vírgula (no QA inclui a origem do web-sandbox).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# /service-keys
# X-Service-Key do mcp-database, único chamador de /feeds/*. Entre 32 e 512 caracteres.
SERVICE_KEY_MCP_DATABASE=

# /recommendation
# Chave antiga (X-Recommendation-Key), aceita só até o mcp-database enviar X-Service-Key.
# RECOMMENDATION_API_KEY=

RECOMMENDATION_RESULT_LIMIT=10
# Acima deste pool a API retorna erro explícito, sem truncar o ranking global.
RECOMMENDATION_POOL_LIMIT=500
# O fallback SQL sorteia RECOMMENDATION_RESULT_LIMIT itens entre os melhores FALLBACK_POOL_SIZE.
FALLBACK_POOL_SIZE=30

# Origens do navegador autorizadas a ler os feeds públicos (CORS), separadas por vírgula.
# Em QA e PROD liste só os domínios reais do web-app; nunca use *.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Cache-Control dos feeds públicos (aplicado também pela Cloudflare).
PUBLIC_CACHE_SECONDS=300
PUBLIC_STALE_IF_ERROR_SECONDS=86400
