# Variáveis de ambiente do serviço.

# Conexão com o banco de grafos Neo4j (ex: instância AuraDB)
NEO4J_URI=neo4j+s://<sua-instancia>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=<sua-senha>

# Chave usada para autenticar chamadas às rotas protegidas (header X-API-Key).
# Gere um valor forte e aleatório, por exemplo com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=<gere-uma-chave-forte-aleatoria>
