# Fonte de verdade real é o Infisical — este arquivo só documenta quais
# variáveis existem. Ver design em docs-warehouse/architecture.

APP_ENVIRONMENT=development
APP_TIMEZONE=America/Sao_Paulo
DOCS_ENABLED=true

# /database (Neo4j: único consumidor, nomes já são específicos - não precisa de pasta compartilhada)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-secret
# NEO4J_DATABASE=neo4j

# /database (Postgres do api-core, acessado somente para leitura, mesma instância/credenciais)
# Em produção DB_POSTGRES_SSLMODE deve ser require, verify-ca ou verify-full.
DB_POSTGRES_HOST=localhost
DB_POSTGRES_PORT=5432
DB_POSTGRES_CORE=dbsolier
DB_POSTGRES_USER=solier_readonly
DB_POSTGRES_PASSWORD=replace-with-a-secret
DB_POSTGRES_SSLMODE=disable

# /recommendation (config de negócio, não é credencial de nenhuma tecnologia)
# Chaves independentes, com pelo menos 32 caracteres em produção.
# Os placeholders abaixo são intencionalmente inválidos e devem ser substituídos.
API_KEY=change-me-api
# X-Sync-Key protege POST /internal/sync/core.
SYNC_API_KEY=change-me-sync
# X-Recommendation-Key protege as rotas de recomendação quando configurada
# e é obrigatória em produção.
RECOMMENDATION_API_KEY=change-me-recommendation

SYNC_ON_STARTUP=false
SYNC_BATCH_SIZE=500
SYNC_LOCK_LEASE_SECONDS=900
# Recusa quedas por domínio abaixo desta proporção em relação ao snapshot ativo.
SYNC_MIN_DOMAIN_RETENTION_RATIO=0.5
# Readiness falha quando o snapshot ativo excede esta idade (24 horas).
SNAPSHOT_MAX_AGE_SECONDS=86400

RECOMMENDATION_RESULT_LIMIT=10
# Acima deste pool a API retorna erro explícito, sem truncar o ranking global.
RECOMMENDATION_POOL_LIMIT=500
