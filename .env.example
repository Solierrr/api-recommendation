# Fonte de verdade real é o Infisical — este arquivo só documenta quais
# variáveis existem. Ver design em docs-warehouse/architecture.

APP_ENVIRONMENT=development
DOCS_ENABLED=true

# /feeddb (Neo4j feeddb, obrigatório: sem estas variáveis os feeds respondem 503)
DB_NEO4J_URI=bolt://localhost:7687
DB_NEO4J_USER=neo4j
DB_NEO4J_PASSWORD=replace-with-a-secret
DB_NEO4J_FEED=feeddb
# Tempo máximo para falar com o Neo4j e pausa antes de tentar de novo depois de uma falha.
GRAPH_TIMEOUT_SECONDS=3
GRAPH_RETRY_AFTER_SECONDS=30

# /recommendation
# X-Recommendation-Key protege /feeds/*. Obrigatória em produção, com pelo menos 32 caracteres.
# O placeholder abaixo é intencionalmente inválido e deve ser substituído.
RECOMMENDATION_API_KEY=change-me-recommendation

RECOMMENDATION_RESULT_LIMIT=10
# Acima deste pool a API retorna erro explícito, sem truncar o ranking global.
RECOMMENDATION_POOL_LIMIT=500

# Origens do navegador autorizadas a ler os feeds públicos (CORS), separadas por vírgula.
# Em QA e PROD liste só os domínios reais do web-app; nunca use *.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Cache-Control dos feeds públicos (aplicado também pela Cloudflare).
PUBLIC_CACHE_SECONDS=300
PUBLIC_STALE_IF_ERROR_SECONDS=86400

# Telemetria: desligada por padrão. Ver RUNNING.md.
# OTEL_SDK_DISABLED=false
# OTEL_SERVICE_NAME=api-recommendation
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
