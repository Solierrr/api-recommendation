meta {
  name: [mutates] POST /events
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/events
  body: json
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
}

body:json {
  {
    "user_id": "{{sampleUuid}}",
    "candidate_id": "{{sampleUuid}}",
    "event_type": "VIEW"
  }
}

docs {
  Writes a recommendation event.
}
