meta {
  name: GET /recommendations/professionals/professions/{{professionId}}
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/recommendations/professionals/professions/{{professionId}}
  body: none
  auth: none
}

params:query {
  strategy: top_rated
}

headers {
  X-Recommendation-Key: {{recommendationKey}}
}

docs {
  Read-only recommendation query; profession ID must exist.
}
